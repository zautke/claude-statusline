# Identity of this plugin and its marketplace. Single source for scripts and tests;
# the JSON manifests cannot interpolate, so tests/test-package.sh asserts they match.
PLUGIN_NAME=claude-statusline
MARKETPLACE=claude-statusline
PLUGIN_ID=claude-statusline@claude-statusline
REPO=zautke/claude-statusline
# Installer-owned launcher home under the Claude config dir. Survives plugin uninstall,
# unlike ${CLAUDE_PLUGIN_DATA}.
LAUNCHER_HOME=claude-statusline
NOT_INSTALLED_MESSAGE=claude-statusline: not installed
